{
  "name": "playcifras",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed && tsx scripts/seed-database.ts && tsx scripts/import-chords.ts",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "import:kaggle": "tsx scripts/import-kaggle.ts",
    "import:cifraclub": "tsx scripts/import-cifraclub.ts",
    "import:chords": "tsx scripts/import-chords.ts",
    "fix:genres": "tsx scripts/fix-genres.ts",
    "fix:chord-alignment": "tsx scripts/fix-chord-alignment.ts",
    "export:chord-pngs": "tsx scripts/export-chord-pngs.ts",
    "images:artists": "tsx scripts/match-artist-images.ts",
    "images:artists:ensure": "tsx scripts/ensure-artist-images.ts",
    "fetch:artist-images": "tsx scripts/fetch-artist-images.ts",
    "link:top-videos": "tsx scripts/link-top-song-videos.ts",
    "clear:lastfm-placeholders": "tsx scripts/clear-lastfm-placeholder-images.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^6.16.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.294.0",
    "next": "14.0.4",
    "next-auth": "^5.0.0-beta.30",
    "postcss": "^8",
    "prisma": "^6.16.3",
    "react": "^18",
    "react-dom": "^18",
    "swr": "^2.4.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tonaljs/chord": "^6.1.2",
    "@tonaljs/chord-type": "^5.1.1",
    "@tonaljs/note": "^4.12.1",
    "@types/bcryptjs": "^2.4.6",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "tsx": "^4.21.0"
  }
}
