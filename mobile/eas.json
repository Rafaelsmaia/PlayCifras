      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://playcifras.vercel.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6796428924",
        "appleTeamId": "YYD5MG9A8L"
      }
    }
  }
}
