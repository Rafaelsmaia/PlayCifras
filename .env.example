# =============================================================================
# Banco de dados
# =============================================================================
# DESENVOLVIMENTO (recomendado): Postgres no seu PC — sem depender do Supabase
# 1) Com Docker:    docker compose up -d
# 2) Ou Postgres instalado localmente (já configurado se usar as URLs abaixo)
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playcifras?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/playcifras?schema=public"

# PRODUÇÃO (opcional): cole as URLs do provedor (Supabase, Neon, etc.) no host de deploy,
# NÃO no .env local do dia a dia.
# Se o terminal mostrar "tenant/user ... not found": o projeto na nuvem pausou/sumiu —
# use o banco local acima para continuar trabalhando.

# NextAuth / Auth.js — obrigatório em produção
# Gere um segredo: openssl rand -base64 32
AUTH_SECRET=

# URL pública da aplicação (desenvolvimento)
AUTH_URL=http://localhost:3000

# Opcional: login com Google (habilita o provedor em auth.ts)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Spotify (recomendado para fotos) — mesmo script: npx tsx scripts/fetch-artist-images.ts
# App: https://developer.spotify.com/dashboard — Client ID + Client Secret (fluxo client credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm — fallback se o Spotify não achar foto
# Chave: https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Opcional: imagem local quando a API não tiver foto (silhueta em public/images/artistas/silhouette.svg)
# DEFAULT_ARTIST_IMAGE=/images/artistas/silhouette.svg

# AdSense (opcional) — banner no topo da página de cifra
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_CIFRA_TOP=xxxxxxxxxx
