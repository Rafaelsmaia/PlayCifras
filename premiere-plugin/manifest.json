{
  "id": "com.playcifras.premiere",
  "name": "PlayCifras",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 6,
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "playcifras.panel",
      "label": {
        "default": "PlayCifras"
      },
      "minimumSize": { "width": 280, "height": 360 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 340, "height": 640 },
      "preferredFloatingSize": { "width": 360, "height": 700 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "clipboard": "readAndWrite",
    "allowCodeGenerationFromStrings": false
  },
  "featureFlags": {
    "enableAlerts": true
  }
}
